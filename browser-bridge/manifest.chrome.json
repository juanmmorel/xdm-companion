{
  "manifest_version": 3,
  "name": "XDM Companion Bridge",
  "version": "1.1.25",
  "description": "Detecta videos en sitios configurados y permite enviar a XDM Companion una calidad que pueda descargar XDM.",
  "icons": {
    "16": "icons/companion-16.png",
    "32": "icons/companion-32.png",
    "48": "icons/companion-48.png",
    "128": "icons/companion-128.png"
  },
  "minimum_chrome_version": "121",
  "permissions": ["cookies", "scripting"],
  "host_permissions": ["http://127.0.0.1:21121/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
