{
  "manifest_version": 3,
  "name": "XDM Companion Bridge",
  "version": "1.1.39",
  "description": "Detecta videos en sitios configurados y permite enviar a XDM Companion una calidad que pueda descargar XDM.",
  "icons": {
    "16": "icons/companion-16.png",
    "32": "icons/companion-32.png",
    "48": "icons/companion-48.png",
    "128": "icons/companion-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "xdm-companion-bridge@xdm.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "browsingActivity",
          "websiteActivity",
          "websiteContent"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": [
    "cookies",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:21121/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
